# Public site URL (used for canonical URLs, sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense site-ownership verification meta tag (safe to publish as soon
# as the AdSense account exists — defaults to ca-pub-4834969820835281 in code
# even if unset here).
NEXT_PUBLIC_ADSENSE_ACCOUNT=ca-pub-4834969820835281

# Google AdSense ad units — leave empty to keep ads disabled (reserved, empty ad slots render instead)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_CONVERTER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BEFORE_FAQ=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Google Analytics — leave empty to disable
NEXT_PUBLIC_GA_ID=

# Currency conversion API (optional) — without these, /tools/currency falls back
# to a clearly-labeled static/manual rate table instead of live rates.
CURRENCY_API_KEY=
CURRENCY_API_URL=

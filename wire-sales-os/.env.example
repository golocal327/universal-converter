# ---------------------------------------------------------------------------
# WIRE Sales OS — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (legacy) or publishable key — safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Needed for the public Lead API, webhook
# delivery/secrets and `npm run seed`. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment (auth redirects, API docs in Settings).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (optional — enables Copilot, AI emails/proposals/briefing). One is enough.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides: provider (auto | anthropic | openai) and models.
AI_PROVIDER=auto
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Lead discovery (optional) — Google Places API (New), Text Search.
GOOGLE_PLACES_API_KEY=
# Lighthouse scores in website audits (optional) — PageSpeed Insights API.
GOOGLE_PAGESPEED_API_KEY=

# Sending email from the app (optional) — Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="WIRE <hola@your-domain.com>"

# Protects /api/cron/deliver-events (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Seed script (optional)
SEED_EMAIL=demo@wire.local
SEED_PASSWORD=
